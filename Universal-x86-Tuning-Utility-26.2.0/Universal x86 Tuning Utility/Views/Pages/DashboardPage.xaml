<ui:UiPage x:Class="Universal_x86_Tuning_Utility.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Universal_x86_Tuning_Utility.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DashboardPage"
    d:DataContext="{d:DesignInstance local:DashboardPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="1000"
    d:DesignWidth="800"
    d:Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Scrollable="True"
    ScrollViewer.PanningMode="VerticalFirst"
    Stylus.IsFlicksEnabled="False"
    Stylus.IsTouchFeedbackEnabled="True"
    ScrollViewer.IsDeferredScrollingEnabled="False"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="164" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            MinHeight="200"
            CornerRadius="8,0,0,0">
                <Border.Background>
                    <ImageBrush
                    ImageSource="pack://application:,,,/Assets/pexels-photo-8037008.jpeg"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Stretch="UniformToFill" />
                </Border.Background>
                <Border CornerRadius="8,0,0,0">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#1F000000" />
                            <GradientStop Offset="1" Color="#4F000000" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!--Background="#66242424"-->
                        <Border Margin="24,16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" CornerRadius="8" Padding="9">
                        <StackPanel
                        
                        Background="Transparent">
                            <TextBlock
                            FontSize="18"
                            Foreground="#B7FFFFFF"
                            Text="Welcome To" />
                            <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Text="VeloX Utility" />
                            <TextBlock
                            FontSize="18"
                            Foreground="#B7FFFFFF"
                            Text="V26.2.0 Stable" />
                            <ui:Button
                                Name="btnPremade"
                            Height="36"
                            Margin="0,12,0,0"
                            Padding="30,6"
                            HorizontalAlignment="Left"
                            Appearance="Transparent"
                            Command="{Binding ViewModel.NavigateCommand}"
                            CommandParameter="premade"
                            Content="Try Out The Premade Presets"
                            Foreground="{DynamicResource TextFillColorLightPrimaryBrush}" />
                        </StackPanel>
                        </Border>
                        

                    <!--<Border Width="320" Height="120" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="0,4,0,0">
                        <Border.Background>
                            <ImageBrush
    ImageSource="pack://application:,,,/Assets/PCC Banner.png"
    RenderOptions.BitmapScalingMode="HighQuality"
    Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>-->
                    </Grid>
                </Border>
            </Border>

        <Grid Grid.Row="1" Margin="12,18,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:CardAction
                Name="caPremade"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,4,0"
                Command="{Binding ViewModel.NavigateCommand}"
                CommandParameter="premade"
                Icon="Predictions20"
                IsChevronVisible="True">
                <StackPanel>
                    <TextBlock
                        Margin="0"
                        FontSize="13"
                        FontWeight="Medium"
                        Text="Premade Presets" />
                </StackPanel>
            </ui:CardAction>

            <ui:CardAction
                Grid.Row="0"
                Grid.Column="1"
                Margin="4,0,4,0"
                Command="{Binding ViewModel.NavigateCommand}"
                CommandParameter="custom"
                Icon="Book20">
                <StackPanel>
                    <TextBlock
                        Margin="0"
                        FontSize="13"
                        FontWeight="Medium"
                        Text="Custom Presets" />
                </StackPanel>
            </ui:CardAction>

            <ui:CardAction
                Grid.Row="0"
                Grid.Column="2"
                Margin="4,0,4,0"
                Command="{Binding ViewModel.NavigateCommand}"
                CommandParameter="adaptive"
                Icon="Radar20">
                <StackPanel>
                    <TextBlock
                        Margin="0"
                        FontSize="13"
                        FontWeight="Medium"
                        Text="Adaptive Mode" />
                </StackPanel>
            </ui:CardAction>

            <ui:CardAction
                Grid.Row="0"
                Grid.Column="3"
                Margin="4,0,0,0"
                Command="{Binding ViewModel.NavigateCommand}"
                CommandParameter="auto"
                Icon="Transmission20">
                <StackPanel>
                    <TextBlock
                        Margin="0"
                        FontSize="13"
                        FontWeight="Medium"
                        Text="Automations" />
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction
                Grid.Row="1"
                Grid.Column="1"
                Margin="4,8,4,0"
                Command="{Binding ViewModel.NavigateCommand}"
                CommandParameter="info"
                Icon="Info20">
                <StackPanel>
                    <TextBlock
                        Margin="0"
                        FontSize="13"
                        FontWeight="Medium"
                        Text="System Info" />
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,8,4,0"
                Command="{Binding ViewModel.NavigateCommand}"
                CommandParameter="games"
                Icon="Games20" 
                IsEnabled="true">
                <StackPanel>
                    <TextBlock
                        Margin="0"
                        FontSize="13"
                        FontWeight="Medium"
                        Text="Game Library" />
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction
                Grid.Row="1"
                Grid.Column="2"
                Margin="4,8,4,0"
                Command="{Binding ViewModel.NavigateCommand}"
                CommandParameter="settings"
                Icon="Settings20">
                <StackPanel>
                    <TextBlock
                        Margin="0"
                        FontSize="13"
                        FontWeight="Medium"
                        Text="Settings" />
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction
                Grid.Row="1"
                Grid.Column="3"
                Margin="4,8,0,0"
                Command="{Binding ViewModel.NavigateCommand}"
                CommandParameter="stresstest"
                Icon="Fire20">
                <StackPanel>
                    <TextBlock
                        Margin="0"
                        FontSize="13"
                        FontWeight="Medium"
                        Text="Stress Test" />
                </StackPanel>
            </ui:CardAction>
        </Grid>

        <!-- Main Controls & AI Assistant Panel -->
        <StackPanel Grid.Row="2" Margin="12,12,12,16">
            
            <!-- CPU Undervolt & Fan Noise Reduction Card -->
            <Border Margin="0,0,0,12" Padding="16" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="❄️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                       Text="CPU Undervolt - Giảm Tiếng Ồn Quạt Khi Chạy"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Hạ điện áp CPU (Undervolting) giúp giảm nhiệt độ máy từ 5°C - 15°C khi đang chạy. Nhờ đó, hệ thống quạt tự động quay chậm và êm hơn rất nhiều, triệt tiêu tiếng hú ồn khó chịu mà vẫn đảm bảo hiệu năng tối đa." />
                    </StackPanel>

                    <!-- Presets & Action Buttons -->
                    <Grid Grid.Row="1" Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Mức độ giảm ồn:" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton x:Name="rbUvQuiet" Content="🔇 Êm dịu (-25 mV)" IsChecked="True" Margin="0,0,12,0"/>
                                <RadioButton x:Name="rbUvBalanced" Content="⚖️ Cân bằng (-15 mV)" Margin="0,0,12,0"/>
                                <RadioButton x:Name="rbUvMild" Content="🛡️ An toàn (-10 mV)" Margin="0,0,12,0"/>
                                <RadioButton x:Name="rbUvAuto" Content="🔄 Tự động (AutoOC)"/>
                            </StackPanel>

                            <TextBlock x:Name="txtUvStatus" 
                                       Text="Trạng thái: Chưa kích hoạt Undervolt. Bấm nút 'Bật Undervolt Giảm Ồn' để làm êm quạt và hạ nhiệt độ ngay." 
                                       FontSize="12.5" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ui:Button x:Name="btnApplyUv" Content="🔇 Bật Undervolt Giảm Ồn"
                                       Appearance="Primary" Padding="16,7" Margin="0,0,8,0"
                                       Click="BtnApplyUv_Click"/>
                            <ui:Button x:Name="btnResetUv" Content="Đặt lại mặc định"
                                       Appearance="Secondary" Padding="12,7"
                                       Click="BtnResetUv_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Notice / Tip -->
                    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="💡 Mẹo: Undervolt là phương pháp an toàn nhất để làm mát CPU và giảm tiếng ồn quạt máy tính mà không làm giảm xung nhịp hay giật lag khi chơi game/làm việc."
                                   FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- AI Advice Panel -->
            <Border Padding="16" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                               Text="🤖 Trợ Lý AI Tối Ưu Hệ Thống"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TxtAiAdvice" TextWrapping="Wrap" Margin="0,0,0,10"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Nhấn nút bên dưới để nhận tư vấn tối ưu từ AI dựa trên thông số phần cứng thực tế." />
                    <ui:Button x:Name="BtnAskAi" Content="⚡ Phân Tích &amp; Tối Ưu"
                               HorizontalAlignment="Left" Padding="20,6"
                               Appearance="Primary"
                               Click="BtnAskAi_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</ui:UiPage>
