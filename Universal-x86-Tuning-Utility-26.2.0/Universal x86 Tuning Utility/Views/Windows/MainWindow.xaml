<ui:UiWindow
    x:Class="Universal_x86_Tuning_Utility.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Universal_x86_Tuning_Utility.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Universal_x86_Tuning_Utility.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    MinWidth="980"
    MinHeight="420"
    Width="1080"
    Height="640"
    d:DataContext="{d:DesignInstance local:MainWindow,
                                     IsDesignTimeCreatable=True}"
    d:Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Name="mainWindow"
    mc:Ignorable="d" StateChanged="UiWindow_StateChanged" Closing="UiWindow_Closing" Loaded="mainWindow_Loaded">

    <ui:UiWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Motion Animations for Chat AI Panel -->
        <Storyboard x:Key="OpenChatAnimation">
            <DoubleAnimation
                Storyboard.TargetName="chatPanelTransform"
                Storyboard.TargetProperty="X"
                From="380" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <QuinticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="chatAiPanel"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="CloseChatAnimation">
            <DoubleAnimation
                Storyboard.TargetName="chatPanelTransform"
                Storyboard.TargetProperty="X"
                From="0" To="380" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="chatAiPanel"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0" Duration="0:0:0.25"/>
        </Storyboard>
    </ui:UiWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="448*"/>
            <ColumnDefinition Width="39*"/>
            <ColumnDefinition Width="13*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="RootMainGrid"
            Grid.Row="1" Grid.ColumnSpan="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  This is the main navigation of the application.  -->
            <ui:NavigationStore
                x:Name="RootNavigation"
                Grid.Column="0"
                Margin="6,0,6,1.5"
                Footer="{Binding ViewModel.NavigationFooter, Mode=TwoWay}"
                Frame="{Binding ElementName=RootFrame, Mode=OneWay}"
                Items="{Binding ViewModel.NavigationItems, Mode=TwoWay}" />

            <!--  We display our pages inside this element.  -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Frame x:Name="RootFrame" Grid.Row="1" />
                </Grid>
            </Border>

            <!-- Transparent Blur Style AI Chat Overlay Panel -->
            <Border
                x:Name="chatAiPanel"
                Grid.Column="1"
                Width="350"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,10,15,15"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Opacity="0"
                Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="0.45" Direction="270" ShadowDepth="4"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="chatPanelTransform" X="380" />
                </Border.RenderTransform>

                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🤖" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Trợ Lý AI VeloX" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Hỗ trợ tối ưu hệ thống &amp; giảm ồn quạt" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:Button
                                x:Name="btnClearChat"
                                Appearance="Transparent"
                                Content="🗑️"
                                ToolTip="Xóa và làm mới cuộc trò chuyện"
                                FontSize="13"
                                Padding="6,4"
                                Margin="0,0,4,0"
                                Click="BtnClearChat_Click"/>
                            <ui:Button
                                x:Name="btnCloseChat"
                                Appearance="Transparent"
                                Content="✕"
                                FontSize="14"
                                FontWeight="Bold"
                                ToolTip="Đóng khung chat"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="8,4"
                                Click="BtnCloseChat_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Chat Messages Area -->
                    <ScrollViewer x:Name="scrollChatMessages" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel x:Name="panelChatMessages">
                            <!-- Welcome Message -->
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="12" Margin="0,0,24,10" HorizontalAlignment="Left" MaxWidth="280">
                                <TextBlock Text="Xin chào! Tôi là Trợ Lý AI VeloX. Tôi có thể hỗ trợ bạn tối ưu CPU/GPU, tư vấn Undervolt để giảm tiếng ồn quạt, hạ nhiệt độ hoặc tăng tốc máy tính. Hãy hỏi tôi bất cứ điều gì!" 
                                           TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Input Box & Send Button -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Quick suggestion chips in Vietnamese -->
                        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="btnPromptFan" Appearance="Secondary" FontSize="11" Padding="8,3" Margin="0,0,5,0" Content="🔇 Giảm ồn quạt" Click="BtnQuickPrompt_Click"/>
                                <ui:Button x:Name="btnPromptCool" Appearance="Secondary" FontSize="11" Padding="8,3" Margin="0,0,5,0" Content="❄️ Hạ nhiệt CPU" Click="BtnQuickPrompt_Click"/>
                                <ui:Button x:Name="btnPromptUv" Appearance="Secondary" FontSize="11" Padding="8,3" Margin="0,0,5,0" Content="⚡ Cách Undervolt" Click="BtnQuickPrompt_Click"/>
                                <ui:Button x:Name="btnPromptGame" Appearance="Secondary" FontSize="11" Padding="8,3" Margin="0,0,0,0" Content="🎮 Tăng FPS" Click="BtnQuickPrompt_Click"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="txtChatMessage"
                                    Grid.Column="0"
                                    Text=""
                                    FontFamily="Segoe UI, Tahoma, Arial"
                                    FontSize="13"
                                    Margin="0,0,6,0"
                                    VerticalContentAlignment="Center"
                                    ToolTip="Nhập câu hỏi bằng tiếng Việt rồi nhấn Enter hoặc nút Gửi"
                                    KeyDown="TxtChatMessage_KeyDown"/>

                                <ui:Button
                                    x:Name="btnToggleVietnamese"
                                    Grid.Column="1"
                                    Appearance="Secondary"
                                    Content="🇻🇳 VN"
                                    ToolTip="Chuyển đổi bộ gõ tiếng Việt Telex tích hợp (Bật/Tắt)"
                                    Padding="10,6"
                                    Margin="0,0,6,0"
                                    Click="BtnToggleVietnamese_Click"/>

                                <ui:Button
                                    x:Name="btnSendChat"
                                    Grid.Column="2"
                                    Appearance="Primary"
                                    Content="Gửi ⚡"
                                    ToolTip="Gửi tin nhắn (Enter)"
                                    Padding="14,6"
                                    Click="BtnSendChat_Click"/>
                            </Grid>

                            <TextBlock
                                Grid.Row="1"
                                FontSize="10.5"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Margin="2,5,0,0"
                                Text="💡 Bộ gõ tiếng Việt Telex đã bật sẵn (hoặc mở UniKey/EVKey bằng quyền Admin để gõ toàn hệ thống)." />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  The title bar contains window navigation elements and theme / chat buttons.  -->
        <ui:TitleBar
            Name="tbMain"
            Title="VeloX Utility"
            Icon="pack://application:,,,/Assets/applicationIcon-256.png"
            UseSnapLayout="True" Grid.ColumnSpan="4" VerticalAlignment="Center">
            <ui:TitleBar.Tray>
                <ui:NotifyIcon
                    Name="niTray"
                    LeftClick="NotifyIcon_LeftClick"
                    FocusOnLeftClick="False"
                    Icon="pack://application:,,,/Assets/applicationIcon-256.png"
                    MenuOnRightClick="True"
                    TooltipText="VeloX Utility">
                    <ui:NotifyIcon.Menu>
                        <ContextMenu>
                            <MenuItem Name="miClose" Header="Close Application" Tag="close" Click="miClose_Click"/>
                        </ContextMenu>
                    </ui:NotifyIcon.Menu>
                </ui:NotifyIcon>
            </ui:TitleBar.Tray>
            <ui:TitleBar.Header>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- Theme Switcher Buttons -->
                    <ui:Button Name="btnThemeLight" Appearance="Transparent" Margin="0,0,4,0" ToolTip="Bright White Mode" Click="BtnThemeLight_Click">☀️ Light</ui:Button>
                    <ui:Button Name="btnThemeDark" Appearance="Transparent" Margin="0,0,4,0" ToolTip="Dark Mode" Click="BtnThemeDark_Click">🌙 Dark</ui:Button>
                    <ui:Button Name="btnThemeSystem" Appearance="Transparent" Margin="0,0,8,0" ToolTip="Follow System Theme" Click="BtnThemeSystem_Click">🖥 System</ui:Button>

                    <!-- Toggle AI Chat Frame Button -->
                    <ui:Button Name="btnToggleChat" Appearance="Primary" Margin="0,0,9,0" ToolTip="Mở/Đóng Trợ lý AI VeloX" Click="BtnToggleChat_Click">🤖 Trò Chuyện AI</ui:Button>

                    <ui:Button Appearance="Transparent" Margin="0,0,9,0" Command="{Binding ViewModel.NavigateCommand}" CommandParameter="download" Content="{Binding ViewModel.Downloads}" Visibility="{Binding ViewModel.IsDownloads, Converter={StaticResource BooleanToVisibilityConverter}}"></ui:Button>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>
    </Grid>
</ui:UiWindow>
